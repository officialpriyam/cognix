    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "@tiptap/extension-mention": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@tiptap/suggestion": "^2.27.2",
    "@vercel/blob": "^2.8.0",
    "@xyflow/react": "^12.11.6",
    "ai": "^5.0.228",
    "bcrypt-ts": "^7.1.0",
    "better-auth": "^1.7.4",
    "chokidar": "^4.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "consola": "^3.4.2",
    "date-fns": "^4.4.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.45.2",
    "emoji-picker-react": "^4.22.2",
    "framer-motion": "^12.43.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "ioredis": "^5.11.1",
    "json-schema": "^0.4.0",
    "katex": "^0.16.47",
    "lucide-react": "^0.486.0",
    "mermaid": "^11.16.1",
    "nanoid": "^5.1.16",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "ogl": "^1.0.11",
    "ollama-ai-provider-v2": "^1.5.5",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^2.15.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "^0.0.1",
    "shiki": "^3.23.0",
    "sonner": "^2.0.8",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.7.0",
    "ts-edge": "^1.0.4",
    "ts-safe": "^0.0.5",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@better-auth-kit/seed": "^1.0.12",
    "@biomejs/biome": "1.9.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{js,json,mjs,ts,yaml,tsx,css}": [
      "pnpm format",
      "pnpm lint:fix"
    ]
  },
  "packageManager": "pnpm@10.2.1",
  "engines": {
    "node": ">=20.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
