{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/main/tauri/src-tauri/schemas/config.schema.json",
  "identifier": "default",
  "description": "Default capabilities for Cognix Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    "shell:default",
    "shell:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://cognix.iampriyam.me/*"
        }
      ]
    }
  ]
}
